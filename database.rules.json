{
  "rules": {
    "analytics": {
      ".read": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'",
      ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'",
      "$entryId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['sessionId','path','timestamp'])"
      }
    },
    "projectViews": {
      ".read": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'",
      ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'",
      "$entryId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['title','timestamp'])"
      }
    },
    "messages": {
      ".read": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'",
      ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'",
      "$msgId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name','email','message','timestamp']) && newData.child('name').isString() && newData.child('email').isString() && newData.child('message').isString() && newData.child('name').val().length < 200 && newData.child('email').val().length < 200 && newData.child('message').val().length < 5000"
      }
    },
    "content": {
      "websites": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'"
      },
      "ugc": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'"
      },
      "testimonials": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_ADMIN_UID'"
      }
    }
  }
}
